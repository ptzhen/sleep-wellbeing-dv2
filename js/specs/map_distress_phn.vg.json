{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "data": {
    "url": "data/phn.topojson",
    "format": {
      "type": "topojson",
      "feature": "phn"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "'No data (suppressed)'",
          "as": "status"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4e4ea",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.PHN_NAME",
            "title": "PHN"
          },
          {
            "field": "status",
            "title": "Distress"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.PHN_CODE",
          "from": {
            "data": {
              "url": "data/phidu_phn_2022.csv"
            },
            "key": "code",
            "fields": [
              "k10_high_persons",
              "k10_high_female",
              "k10_high_male"
            ]
          }
        },
        {
          "filter": "isValid(datum.k10_high_persons)"
        },
        {
          "calculate": "datum.k10_high_female - datum.k10_high_male",
          "as": "gap"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "k10_high_persons",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              11,
              13,
              15,
              17
            ],
            "range": [
              "#e6e1f2",
              "#bdb0dd",
              "#8e7cc3",
              "#5e4a9e",
              "#2f2366"
            ]
          },
          "legend": {
            "orient": "top-left",
            "title": "% adults in high distress"
          }
        },
        "tooltip": [
          {
            "field": "properties.PHN_NAME",
            "title": "PHN"
          },
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "k10_high_persons",
            "type": "quantitative",
            "title": "All adults (%)",
            "format": ".1f"
          },
          {
            "field": "k10_high_female",
            "type": "quantitative",
            "title": "Women (%)",
            "format": ".1f"
          },
          {
            "field": "k10_high_male",
            "type": "quantitative",
            "title": "Men (%)",
            "format": ".1f"
          },
          {
            "field": "gap",
            "type": "quantitative",
            "title": "Gap (points)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.16,
            "lat": -33.62,
            "lab": "Northern Sydney 8.8%",
            "dx": 34,
            "dy": 14
          },
          {
            "lon": 151.11,
            "lat": -27.29,
            "lab": "Darling Downs and\nWest Moreton 17.3%",
            "dx": 44,
            "dy": -30
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#23263a",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat2"
            }
          },
          "transform": [
            {
              "calculate": "datum.lon + datum.dx / 14",
              "as": "lon2"
            },
            {
              "calculate": "datum.lat - datum.dy / 14",
              "as": "lat2"
            }
          ]
        },
        {
          "mark": {
            "type": "circle",
            "size": 22,
            "color": "#23263a",
            "opacity": 1
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.lon + datum.dx / 14",
              "as": "lon2"
            },
            {
              "calculate": "datum.lat - datum.dy / 14",
              "as": "lat2"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#23263a",
            "lineBreak": "\n",
            "stroke": "#fbfaf7",
            "strokeWidth": 3,
            "strokeOpacity": 0.9
          },
          "encoding": {
            "longitude": {
              "field": "lon2"
            },
            "latitude": {
              "field": "lat2"
            },
            "text": {
              "field": "lab"
            }
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.lon + datum.dx / 14",
              "as": "lon2"
            },
            {
              "calculate": "datum.lat - datum.dy / 14",
              "as": "lat2"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#23263a",
            "lineBreak": "\n"
          },
          "encoding": {
            "longitude": {
              "field": "lon2"
            },
            "latitude": {
              "field": "lat2"
            },
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
