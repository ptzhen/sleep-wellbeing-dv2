{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/tus2024_sleep_summary.csv",
    "format": {
      "parse": {
        "sleep_min": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.day_type != 'All days'"
    },
    {
      "calculate": "datum.sex == 'All' ? 'Everyone' : datum.sex",
      "as": "who"
    },
    {
      "calculate": "floor(datum.sleep_min/60) + 'h ' + (datum.sleep_min % 60) + 'm'",
      "as": "hm"
    },
    {
      "calculate": "datum.who == 'Men' ? -9 : datum.who == 'Women' ? 9 : 0",
      "as": "nudge"
    },
    {
      "calculate": "datum.day_type == 'Weekday' ? datum.sleep_min : null",
      "as": "wk"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "wk",
          "as": "wkval"
        }
      ],
      "groupby": [
        "who"
      ]
    },
    {
      "calculate": "datum.wkval + (datum.sleep_min - datum.wkval) * reveal",
      "as": "shown"
    }
  ],
  "params": [
    {
      "name": "reveal",
      "value": 1
    }
  ],
  "encoding": {
    "x": {
      "field": "day_type",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0.5
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "domain": false,
        "ticks": false,
        "orient": "top"
      }
    },
    "y": {
      "field": "shown",
      "type": "quantitative",
      "title": "Minutes asleep",
      "scale": {
        "domain": [
          500,
          570
        ]
      },
      "axis": {
        "grid": true,
        "values": [
          500,
          510,
          520,
          530,
          540,
          550,
          560,
          570
        ]
      }
    },
    "color": {
      "field": "who",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Women",
          "Men",
          "Everyone"
        ],
        "range": [
          "#c4527a",
          "#2a7fbf",
          "#23263a"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "who"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "who",
            "title": "Who"
          },
          {
            "field": "day_type",
            "title": "Day"
          },
          {
            "field": "hm",
            "title": "Sleep"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.day_type == 'Weekend'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "dy": {
          "expr": "datum.nudge"
        }
      },
      "encoding": {
        "text": {
          "field": "who"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.day_type == 'Weekday' && datum.who == 'Everyone'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "hm"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.day_type == 'Weekend' && datum.who == 'Everyone'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 70,
        "fontSize": 12,
        "fontWeight": 700,
        "opacity": {
          "expr": "reveal"
        }
      },
      "encoding": {
        "text": {
          "value": "+44 min"
        },
        "color": {
          "value": "#d08a1e"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
