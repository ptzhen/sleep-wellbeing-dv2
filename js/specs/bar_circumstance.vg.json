{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "url": "data/sleep_by_circumstance.csv"
  },
  "params": [
    {
      "name": "circSex",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Women",
          "Men"
        ],
        "labels": [
          "Everyone",
          "Women",
          "Men"
        ],
        "name": "Show: "
      }
    },
    {
      "name": "reveal",
      "value": 1
    }
  ],
  "transform": [
    {
      "filter": "datum.sex == circSex"
    },
    {
      "calculate": "datum.sleep_min - 528",
      "as": "diff"
    },
    {
      "calculate": "datum.diff >= 0 ? 'More than average' : 'Less than average'",
      "as": "dir"
    },
    {
      "calculate": "(datum.diff > 0 ? '+' : '') + datum.diff + ' min'",
      "as": "difflabel"
    },
    {
      "calculate": "floor(datum.sleep_min/60) + 'h ' + (datum.sleep_min % 60) + 'm'",
      "as": "hm"
    },
    {
      "calculate": "datum.diff * reveal",
      "as": "diff_shown"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Parent, youngest child under 1",
        "Parent, youngest child aged 1",
        "Parent, youngest child 2–4",
        "Parent, youngest child 5–11",
        "Parent, youngest child 12–14",
        "No child under 15 at home",
        "Carer",
        "Not a carer",
        "Volunteer",
        "Not a volunteer",
        "Has a disability",
        "No disability"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 320
      }
    },
    "x": {
      "field": "diff_shown",
      "type": "quantitative",
      "title": "Minutes compared with the average adult",
      "scale": {
        "domain": [
          -40,
          20
        ]
      },
      "axis": {
        "grid": true,
        "values": [
          -40,
          -30,
          -20,
          -10,
          0,
          10,
          20
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 16,
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "dir",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Less than average",
              "More than average"
            ],
            "range": [
              "#e9a23b",
              "#86a3e6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "hm",
            "title": "Sleep a day"
          },
          {
            "field": "difflabel",
            "title": "Compared with average"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#e9e7f3"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": null
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "dx": {
          "expr": "datum.diff >= 0 ? 6 : -6"
        },
        "align": {
          "expr": "datum.diff >= 0 ? 'left' : 'right'"
        },
        "opacity": {
          "expr": "reveal"
        }
      },
      "encoding": {
        "text": {
          "field": "difflabel"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
