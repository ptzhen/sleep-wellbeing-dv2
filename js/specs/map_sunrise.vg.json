{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "params": [
    {
      "name": "season",
      "value": "Summer (21 December)",
      "bind": {
        "input": "radio",
        "options": [
          "Summer (21 December)",
          "Winter (21 June)"
        ],
        "labels": [
          "Summer (21 December)",
          "Winter (21 June)"
        ],
        "name": "Day: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/sunrise_bands.topojson",
        "format": {
          "type": "topojson",
          "feature": "bands"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.season == season"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "properties.label",
          "type": "ordinal",
          "title": "Sunrise (clock time)",
          "scale": {
            "domain": [
              "before 4:30 am",
              "4:30–5:00 am",
              "5:00–5:30 am",
              "5:30–6:00 am",
              "6:00–6:30 am",
              "6:30–7:00 am",
              "7:00–7:30 am",
              "after 7:30 am"
            ],
            "range": [
              "#fff4c8",
              "#fde2a0",
              "#f6c27a",
              "#e79a5c",
              "#c96f4f",
              "#96505a",
              "#5e3a5e",
              "#2b2a55"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4,
            "symbolType": "square",
            "symbolSize": 160,
            "labelFontSize": 12,
            "columnPadding": 16,
            "rowPadding": 6
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "title": "State"
          },
          {
            "field": "properties.label",
            "title": "Sunrise"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "aus_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#23263a",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/sunrise_cities.csv"
      },
      "transform": [
        {
          "filter": "datum.season == season"
        },
        {
          "calculate": "datum.city + ' ' + datum.sunrise_label",
          "as": "lab"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 34,
            "color": "#23263a",
            "stroke": "#ffffff",
            "strokeWidth": 1,
            "opacity": 1
          },
          "encoding": {
            "tooltip": [
              {
                "field": "city",
                "title": "City"
              },
              {
                "field": "sunrise_label",
                "title": "Sunrise"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#23263a",
            "dx": {
              "expr": "datum.city == 'Adelaide' || datum.city == 'Melbourne' ? -6 : 6"
            },
            "align": {
              "expr": "datum.city == 'Adelaide' || datum.city == 'Melbourne' ? 'right' : 'left'"
            },
            "dy": {
              "expr": "datum.city == 'Canberra' ? 8 : datum.city == 'Sydney' ? -4 : datum.city == 'Melbourne' ? 6 : datum.city == 'Adelaide' ? -4 : 0"
            },
            "stroke": "#ffffff",
            "strokeWidth": 3,
            "strokeOpacity": 0.85
          },
          "encoding": {
            "text": {
              "field": "lab"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#23263a",
            "dx": {
              "expr": "datum.city == 'Adelaide' || datum.city == 'Melbourne' ? -6 : 6"
            },
            "align": {
              "expr": "datum.city == 'Adelaide' || datum.city == 'Melbourne' ? 'right' : 'left'"
            },
            "dy": {
              "expr": "datum.city == 'Canberra' ? 8 : datum.city == 'Sydney' ? -4 : datum.city == 'Melbourne' ? 6 : datum.city == 'Adelaide' ? -4 : 0"
            }
          },
          "encoding": {
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
