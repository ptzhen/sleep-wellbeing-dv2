{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "data/world_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },
  "transform": [
    {
      "filter": "datum.properties.CONTINENT != 'Antarctica'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#2f365f",
        "stroke": "#1a2150",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "title": "Country"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.ADM0_A3",
          "from": {
            "data": {
              "url": "data/oecd_sleep_by_country.csv"
            },
            "key": "iso3",
            "fields": [
              "sleep_min_total",
              "survey_year",
              "age_group",
              "country"
            ]
          }
        },
        {
          "filter": "isValid(datum.sleep_min_total)"
        },
        {
          "calculate": "floor(datum.sleep_min_total/60) + 'h ' + round(datum.sleep_min_total % 60) + 'm'",
          "as": "hm"
        }
      ],
      "params": [
        {
          "name": "hoverCountry",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#1a2150",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "sleep_min_total",
          "type": "quantitative",
          "title": "Minutes of sleep a day",
          "scale": {
            "type": "threshold",
            "domain": [
              480,
              500,
              510,
              520,
              530
            ],
            "range": [
              "#5670b8",
              "#6a84d0",
              "#86a0e2",
              "#a5bbf0",
              "#c6d5f8",
              "#e6edff"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 320,
            "labelOverlap": false
          }
        },
        "stroke": {
          "condition": {
            "param": "hoverCountry",
            "empty": false,
            "value": "#e9e7f3"
          },
          "value": "#1a2150"
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverCountry",
            "empty": false,
            "value": 1.5
          },
          "value": 0.4
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "hm",
            "title": "Sleep per day"
          },
          {
            "field": "survey_year",
            "title": "Survey year"
          },
          {
            "field": "age_group",
            "title": "Ages covered"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.properties.ADM0_A3 == 'AUS'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#e9a23b",
        "strokeWidth": 2
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 128,
            "lat": -49,
            "t": "Australia 8h 32m"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "fontWeight": 600,
        "baseline": "middle",
        "align": "center",
        "color": "#e9a23b",
        "opacity": {
          "expr": "width < 520 ? 1 : 1"
        },
        "dy": {
          "expr": "width < 520 ? 7 : 0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 147,
            "lat": 31,
            "t": "Japan 7h 24m, the least"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "fontWeight": 600,
        "baseline": "middle",
        "align": "left",
        "color": "#e9e7f3",
        "opacity": {
          "expr": "width < 520 ? 0 : 1"
        },
        "dy": {
          "expr": "width < 520 ? 7 : 0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 13,
            "lat": -37,
            "t": "South Africa 9h 13m, the most"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "fontWeight": 600,
        "baseline": "middle",
        "align": "right",
        "color": "#e9e7f3",
        "opacity": {
          "expr": "width < 520 ? 0 : 1"
        },
        "dy": {
          "expr": "width < 520 ? 7 : 0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
