        {
          "data": {
            "values": [
              {
                "lon": 151.11,
                "lat": -27.29,
                "lon2": 156.5,
                "lat2": -24.5,
                "lab": "Largest gap:\nDarling Downs 7.3"
              }
            ]
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          },
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "#23263a",
                "strokeWidth": 0.8
              },
              "encoding": {
                "longitude2": {
                  "field": "lon2"
                },
                "latitude2": {
                  "field": "lat2"
                }
              }
            },
            {
              "mark": {
                "type": "circle",
                "size": 20,
                "color": "#23263a",
                "opacity": 1
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 10.5,
