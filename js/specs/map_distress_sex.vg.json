{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/phn.topojson",
    "format": {
      "type": "topojson",
      "feature": "phn"
    }
  },
  "hconcat": [
    {
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0
        ],
        "center": [
          0,
          -27
        ],
        "scale": 405,
        "translate": [
          150,
          127.0
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "calculate": "'No data (suppressed)'",
              "as": "status"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#e4e4ea",
            "stroke": "#ffffff",
            "strokeWidth": 0.5
          },
          "encoding": {
            "tooltip": [
              {
                "field": "properties.PHN_NAME",
                "title": "PHN"
              },
              {
                "field": "status",
                "title": "Distress"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "lookup": "properties.PHN_CODE",
              "from": {
                "data": {
                  "url": "data/phidu_phn_2022.csv"
                },
                "key": "code",
                "fields": [
                  "k10_high_persons",
                  "k10_high_female",
                  "k10_high_male"
                ]
              }
            },
            {
              "filter": "isValid(datum.k10_high_persons)"
            },
            {
              "calculate": "datum.k10_high_female - datum.k10_high_male",
              "as": "gap"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 0.5
          },
          "encoding": {
            "color": {
              "field": "k10_high_female",
              "type": "quantitative",
              "scale": {
                "type": "threshold",
                "domain": [
                  9,
                  11,
                  13,
                  15,
                  17,
                  19
                ],
                "range": [
                  "#efedf6",
                  "#d9d3ea",
                  "#bdb0dd",
                  "#9b8bca",
                  "#7a66b4",
                  "#5a4697",
                  "#2f2366"
                ]
              },
              "legend": {
                "orient": "bottom",
                "title": "% in high distress (women and men)",
                "direction": "horizontal",
                "labelOverlap": false,
                "titleLimit": 400
              }
            },
            "tooltip": [
              {
                "field": "properties.PHN_NAME",
                "title": "PHN"
              },
              {
                "field": "properties.STATE_NAME",
                "title": "State"
              },
              {
                "field": "k10_high_persons",
                "type": "quantitative",
                "title": "All adults (%)",
                "format": ".1f"
              },
              {
                "field": "k10_high_female",
                "type": "quantitative",
                "title": "Women (%)",
                "format": ".1f"
              },
              {
                "field": "k10_high_male",
                "type": "quantitative",
                "title": "Men (%)",
                "format": ".1f"
              },
              {
                "field": "gap",
                "type": "quantitative",
                "title": "Gap (points)",
                "format": ".1f"
              }
            ]
          }
        }
      ],
      "width": 300,
      "height": 270,
      "title": {
        "text": "Women",
        "fontSize": 14,
        "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
        "fontWeight": 600
      }
    },
    {
