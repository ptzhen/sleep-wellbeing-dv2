{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {
    "step": 46
  },
  "data": {
    "values": [
      {
        "habit": "Work in the hour before bed",
        "level": "Never",
        "kind": "Healthier habit",
        "pct": 36.5
      },
      {
        "habit": "Work in the hour before bed",
        "level": "Nightly",
        "kind": "Riskier habit",
        "pct": 71.4
      },
      {
        "habit": "Sleep before work days",
        "level": "5.5 to 9 hours",
        "kind": "Healthier habit",
        "pct": 43.6
      },
      {
        "habit": "Sleep before work days",
        "level": "Under 5.5 hours",
        "kind": "Riskier habit",
        "pct": 75.7
      },
      {
        "habit": "Caffeinated drinks a day",
        "level": "None",
        "kind": "Healthier habit",
        "pct": 40.5
      },
      {
        "habit": "Caffeinated drinks a day",
        "level": "6 or more",
        "kind": "Riskier habit",
        "pct": 60.6
      },
      {
        "habit": "Internet in the hour before bed",
        "level": "Never",
        "kind": "Healthier habit",
        "pct": 38.8
      },
      {
        "habit": "Internet in the hour before bed",
        "level": "Nightly",
        "kind": "Riskier habit",
        "pct": 58.5
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "habit",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "pct",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 320
      }
    },
    "x": {
      "field": "pct",
      "type": "quantitative",
      "title": "% with two or more sleep problems",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#5f669e"
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "pct"
        },
        "x2": {
          "aggregate": "max",
          "field": "pct"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 140,
        "opacity": 1,
        "stroke": "#1a2150",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "kind",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Healthier habit",
              "Riskier habit"
            ],
            "range": [
              "#86a3e6",
              "#e9a23b"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "habit",
            "title": "Habit"
          },
          {
            "field": "level",
            "title": "Level"
          },
          {
            "field": "pct",
            "title": "% with 2+ problems",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "color": "#b4b2cf"
      },
      "encoding": {
        "text": {
          "field": "level"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#b4b2cf",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "opacity": {
          "expr": "width < 420 ? 0 : 1"
        }
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "datum.habit == 'Work in the hour before bed' && datum.level == 'Nightly'",
            "value": "Nearly double"
          },
          "value": ""
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
