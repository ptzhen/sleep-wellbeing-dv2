      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
