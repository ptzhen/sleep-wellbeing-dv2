{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/tus_activity_by_hour.csv",
    "format": {
      "type": "csv",
      "parse": {
        "hour_start": "number",
        "pct": "number"
      }
    }
  },
  "params": [
    {
      "name": "sexSel",
      "value": "Persons",
      "bind": {
        "input": "radio",
        "options": [
          "Persons",
          "Females",
          "Males"
        ],
        "labels": [
          "Everyone",
          "Women",
          "Men"
        ],
        "name": "Show: "
      }
    },
    {
      "name": "playHour",
      "value": 7,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 23,
        "step": 1,
        "name": "Hour (0 = midnight): "
      }
    },
    {
      "name": "playing",
      "value": false
    }
  ],
  "transform": [
    {
      "filter": "datum.activity == 'Sleep' && datum.sex == sexSel && datum.day_type != 'All days'"
    },
    {
      "calculate": "datum.hour_start + 1",
      "as": "hour_end"
    },
    {
      "calculate": "datum.hour_start % 3 != 0 ? '' : datum.hour_start == 0 ? '12 am' : datum.hour_start == 12 ? '12 pm' : datum.hour_start < 12 ? datum.hour_start + ' am' : (datum.hour_start - 12) + ' pm'",
      "as": "hourlabel"
    }
  ],
  "hconcat": [
    {
      "transform": [
        {
          "filter": "datum.day_type == 'Weekday'"
        }
      ],
      "title": {
        "text": "Weekdays",
        "fontSize": 14,
        "anchor": "middle",
        "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
        "fontWeight": 600
      },
      "width": 260,
      "height": 260,
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.hour_start == playHour"
            }
          ],
          "mark": {
            "type": "arc",
            "filled": false,
            "stroke": "#e9e7f3",
            "strokeWidth": 2,
            "innerRadius": 18
          },
          "encoding": {
            "theta": {
              "field": "hour_start",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  24
                ]
              }
            },
            "theta2": {
              "field": "hour_end"
            },
            "radius": {
              "field": "pct",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "domain": [
                  0,
                  100
                ],
                "range": [
                  18,
                  125
                ]
              }
            }
          }
        },
        {
          "mark": {
            "type": "arc",
            "stroke": "#1a2150",
            "strokeWidth": 1,
            "innerRadius": 18,
            "cornerRadius": 2
          },
          "encoding": {
            "theta": {
              "field": "hour_start",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  24
                ]
              }
            },
            "theta2": {
              "field": "hour_end"
            },
            "radius": {
              "field": "pct",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "domain": [
                  0,
                  100
                ],
                "range": [
                  18,
                  125
                ]
              }
            },
            "color": {
              "value": "#86a3e6"
            },
            "opacity": {
              "condition": [
                {
                  "test": "playing && datum.hour_start != playHour",
                  "value": 0.3
                },
                {
                  "param": "hourHover",
                  "empty": true,
                  "value": 1
                }
              ],
              "value": 0.35
            },
            "tooltip": [
              {
                "field": "time_label",
                "title": "Time"
              },
              {
                "field": "pct",
                "title": "% asleep",
                "format": ".1f"
              }
            ]
          },
          "params": [
            {
              "name": "hourHover",
              "select": {
                "type": "point",
                "fields": [
                  "hour_start"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "data": {
            "values": [
              {
                "r": 50
              }
            ]
          },
          "mark": {
            "type": "arc",
            "filled": false,
            "stroke": "#1a2150",
            "strokeWidth": 2.5
          },
          "encoding": {
            "theta": {
              "datum": 0,
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  24
                ]
              }
            },
            "theta2": {
              "datum": 24
            },
            "radius": {
              "field": "r",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "r": 50
              }
            ]
          },
          "mark": {
            "type": "arc",
            "filled": false,
            "stroke": "#e9e7f3",
            "strokeWidth": 1,
            "strokeDash": [
              3,
              3
            ]
          },
          "encoding": {
            "theta": {
              "datum": 0,
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  24
                ]
              }
            },
            "theta2": {
              "datum": 24
            },
            "radius": {
              "field": "r",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.hour_start == playHour"
            },
            {
              "calculate": "format(datum.pct, '.0f') + '% asleep at ' + (playHour == 0 ? '12' : playHour <= 12 ? playHour : playHour - 12) + (playHour < 12 ? ' am' : ' pm') + '–' + ((playHour + 1) % 24 == 0 ? '12' : (playHour + 1) <= 12 ? playHour + 1 : playHour - 11) + ((playHour + 1) % 24 < 12 ? ' am' : ' pm')",
              "as": "note"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#e9e7f3",
            "align": "center"
          },
          "encoding": {
            "x": {
              "value": 130
            },
            "y": {
              "value": 292
            },
            "text": {
              "field": "note"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "radius": 140,
            "fontSize": 11,
            "color": "#b4b2cf"
          },
          "encoding": {
            "theta": {
              "field": "hour_start",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  24
                ]
              }
            },
            "text": {
              "field": "hourlabel"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.day_type == 'Weekend'"
        }
      ],
      "title": {
        "text": "Weekends",
        "fontSize": 14,
        "anchor": "middle",
        "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
        "fontWeight": 600
      },
