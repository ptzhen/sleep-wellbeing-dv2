{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {
    "step": 15
  },
  "data": {
    "url": "data/oecd_sleep_by_country.csv"
  },
  "transform": [
    {
      "fold": [
        "sleep_min_men",
        "sleep_min_women"
      ],
      "as": [
        "sexkey",
        "minutes"
      ]
    },
    {
      "calculate": "datum.sexkey == 'sleep_min_men' ? 'Men' : 'Women'",
      "as": "sex"
    },
    {
      "calculate": "datum.country == 'Australia' ? 'Australia ★' : datum.country",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "sleep_min_total",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "labelColor": {
          "condition": {
            "test": "datum.value == 'Australia ★'",
            "value": "#e9a23b"
          },
          "value": "#e9e7f3"
        },
        "labelFontWeight": {
          "condition": {
            "test": "datum.value == 'Australia ★'",
            "value": 700
          },
          "value": 400
        },
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "minutes",
      "type": "quantitative",
      "title": "Minutes of sleep per day",
      "scale": {
        "domain": [
          430,
          560
        ]
      },
      "axis": {
        "grid": true,
        "orient": "top",
        "values": [
          440,
          460,
          480,
          500,
          520,
          540,
          560
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#5f669e",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "minutes"
        },
        "x2": {
          "aggregate": "max",
          "field": "minutes"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1,
        "stroke": "#1a2150",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Women",
              "Men"
            ],
            "range": [
              "#f08bb0",
              "#6fb7ec"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "sex",
            "title": "Sex"
          },
          {
            "field": "minutes",
            "title": "Minutes a day",
            "format": ".0f"
          },
          {
            "field": "survey_year",
            "title": "Survey year"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
