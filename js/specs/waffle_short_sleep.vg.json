{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "datum.i % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.i / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.i < round(33 * reveal) ? 'Less than 7 hours' : '7 hours or more'",
      "as": "group"
    }
  ],
  "params": [
    {
      "name": "reveal",
      "value": 1
    }
  ],
  "mark": {
    "type": "square",
    "size": 520,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Less than 7 hours",
          "7 hours or more"
        ],
        "range": [
          "#e9a23b",
          "#7d83aa"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Usual sleep"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
