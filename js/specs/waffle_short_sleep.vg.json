{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "1 in 3 Australian adults sleep less than 7 hours",
    "subtitle": [
      "Each square is 1 in 100 adults, by usual sleep a night",
      "Sleep Health Foundation, Aussie Sleep Snapshot",
      "2025 (n = 1,012)"
    ]
  },
  "width": 300,
  "height": 300,
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "datum.i % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.i / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.i < 33 ? 'Less than 7 hours' : '7 hours or more'",
      "as": "group"
    }
  ],
  "mark": {
    "type": "square",
    "size": 520,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Less than 7 hours",
          "7 hours or more"
        ],
        "range": [
          "#d08a1e",
          "#cdd3e6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Usual sleep"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
