{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Outside the capitals distress is higher, except in Brisbane and Hobart",
    "subtitle": [
      "% of adults with high or very high distress, capital city vs rest of state, 2022",
      "PHIDU Social Health Atlas (ACT not shown: it is all capital)"
    ]
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "data": {
    "url": "data/capital_vs_rest.csv"
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "k10_high_persons",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "k10_high_persons",
      "type": "quantitative",
      "title": "% of adults in high distress",
      "scale": {
        "domain": [
          10,
          18
        ]
      },
      "axis": {
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#c9c5bb"
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "k10_high_persons"
        },
        "x2": {
          "aggregate": "max",
          "field": "k10_high_persons"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "opacity": 1,
        "stroke": "#fbfaf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "area",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Capital city",
              "Rest of state"
            ],
            "range": [
              "#8e7cc3",
              "#2f2366"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "area_name",
            "title": "Area"
          },
          {
            "field": "k10_high_persons",
            "title": "% in high distress",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "Source Sans 3, Helvetica Neue, Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
