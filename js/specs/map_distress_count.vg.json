{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "hconcat": [
    {
      "name": "symmap",
      "width": 500,
      "height": 430,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/aus_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "aus_states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#ece9e2",
            "stroke": "#ffffff",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/phn_distress_counts.csv"
          },
          "transform": [
            {
              "filter": "isValid(datum.distressed_adults) && datum.distressed_adults > 0"
            }
          ],
          "params": [
            {
              "name": "hoverMap",
              "select": {
                "type": "point",
                "fields": [
                  "code"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#ffffff",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "distressed_adults",
              "type": "quantitative",
              "title": "Distressed adults",
              "scale": {
                "type": "linear",
                "domain": [
                  0,
                  210000
                ],
                "range": [
                  0,
                  1500
                ]
              },
              "legend": {
                "orient": "top-left",
                "values": [
                  25000,
                  100000,
                  200000
                ],
                "format": ",.0f",
                "symbolFillColor": "#5e4a9e",
                "symbolOpacity": 0.6,
                "symbolStrokeColor": "#ffffff"
              }
            },
            "color": {
              "condition": {
                "test": {
                  "or": [
                    {
                      "param": "hoverMap",
                      "empty": false
                    },
                    {
                      "param": "hoverBar",
                      "empty": false
                    }
                  ]
                },
                "value": "#d08a1e"
              },
              "value": "#5e4a9e"
            },
            "opacity": {
              "condition": {
                "test": {
                  "or": [
                    {
                      "param": "hoverMap",
                      "empty": false
                    },
                    {
                      "param": "hoverBar",
                      "empty": false
                    }
                  ]
                },
                "value": 0.95
              },
              "value": 0.6
            },
            "order": {
              "field": "distressed_adults",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "name",
                "title": "PHN"
              },
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "distressed_adults",
                "title": "Distressed adults (est.)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 144.706,
                "lat": -37.576,
                "lon2": 137.5,
                "lat2": -41.5,
                "lab": "Most: North Western Melbourne,\nabout 205,000 adults"
              }
            ]
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          },
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "#23263a",
                "strokeWidth": 0.8
              },
              "encoding": {
                "longitude2": {
                  "field": "lon2"
                },
                "latitude2": {
                  "field": "lat2"
                }
              }
            },
            {
              "mark": {
                "type": "circle",
                "size": 20,
                "color": "#23263a",
                "opacity": 1
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "center",
                "baseline": "middle",
                "fontSize": 11,
                "fontWeight": 600,
                "color": "#23263a",
                "lineBreak": "\n",
                "stroke": "#fbfaf7",
                "strokeWidth": 3,
                "strokeOpacity": 0.9
              },
              "encoding": {
                "longitude": {
                  "field": "lon2",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat2",
                  "type": "quantitative"
                },
                "text": {
                  "field": "lab"
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "center",
                "baseline": "middle",
                "fontSize": 11,
                "fontWeight": 600,
                "color": "#23263a",
                "lineBreak": "\n"
              },
              "encoding": {
                "longitude": {
                  "field": "lon2",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat2",
                  "type": "quantitative"
                },
                "text": {
                  "field": "lab"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "symbars",
      "width": 200,
      "height": {
        "step": 14
      },
      "data": {
        "url": "data/phn_distress_counts.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.distressed_adults) && datum.distressed_adults > 0"
        }
      ],
      "params": [
        {
          "name": "hoverBar",
          "select": {
            "type": "point",
            "fields": [
              "code"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "height": 10,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 11,
            "labelLimit": 220
          }
        },
        "x": {
          "field": "distressed_adults",
          "type": "quantitative",
          "title": "Distressed adults",
          "axis": {
            "format": "~s",
            "grid": true,
            "tickCount": 4
          }
        },
        "color": {
          "condition": {
            "test": {
              "or": [
                {
                  "param": "hoverMap",
                  "empty": false
                },
                {
                  "param": "hoverBar",
                  "empty": false
                }
              ]
            },
            "value": "#d08a1e"
          },
          "value": "#5e4a9e"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "PHN"
          },
          {
            "field": "distressed_adults",
            "title": "Distressed adults (est.)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "spacing": 40,
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#23263a",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#5d6077",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#5d6077",
      "gridColor": "#e6e3dc",
      "labelLimit": 320,
      "domainColor": "#c9c5bb",
      "tickColor": "#c9c5bb",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#5d6077",
      "labelColor": "#23263a",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#23263a",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#23263a"
    }
  }
}
