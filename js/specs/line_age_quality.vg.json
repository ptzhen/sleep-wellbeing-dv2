{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/shf2016_by_age.csv"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 92
  },
  "transform": [
    {
      "filter": "datum.age_group != 'All' && (datum.measure == 'adequate_sleep' || datum.measure == 'wake_unrefreshed')"
    },
    {
      "calculate": "datum.measure == 'adequate_sleep' ? 'Get enough sleep' : 'Wake up unrefreshed'",
      "as": "label"
    },
    {
      "calculate": "datum.measure == 'adequate_sleep' ? 'Enough sleep' : 'Unrefreshed'",
      "as": "short"
    }
  ],
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age group",
      "sort": [
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ],
      "axis": {
        "labelAngle": {
          "expr": "width < 420 ? -40 : 0"
        }
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "% of adults",
      "scale": {
        "domain": [
          0,
          80
        ]
      }
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Get enough sleep",
          "Wake up unrefreshed"
        ],
        "range": [
          "#86a3e6",
          "#e9a23b"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "size": 60,
          "filled": true
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "label",
            "title": "Measure"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "pct",
            "title": "% of adults",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_group == '18-24' || datum.age_group == '65+'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_group == '65+'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "short"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "From the mid-30s, more feel rested than unrefreshed"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#b4b2cf",
        "align": "center",
        "opacity": {
          "expr": "width < 420 ? 0 : 1"
        }
      },
      "encoding": {
        "x": {
          "datum": "35-44",
          "type": "ordinal"
        },
        "y": {
          "value": 200
        },
        "text": {
          "field": "t"
        },
        "color": {
          "value": "#b4b2cf"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#e9e7f3",
      "anchor": "start",
      "subtitleFont": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "subtitleFontSize": 13,
      "subtitleFontWeight": 400,
      "subtitleColor": "#b4b2cf",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#b4b2cf",
      "gridColor": "#2b3266",
      "labelLimit": 320,
      "domainColor": "#5f669e",
      "tickColor": "#5f669e",
      "titleFontWeight": 400
    },
    "legend": {
      "labelLimit": 260,
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#b4b2cf",
      "labelColor": "#e9e7f3",
      "titleFontWeight": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#e9e7f3",
      "titleFontSize": 13
    },
    "text": {
      "font": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif",
      "color": "#e9e7f3"
    }
  }
}
